{
  "framework": null,
  "cleanUrls": true,
  "buildCommand": "npm run generate-levels && npx expo export -p web",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "rewrites": [
    {
      "source": "/partilha/:kind/:value",
      "has": [
        {
          "type": "query",
          "key": "lang",
          "value": "(?<lang>.*)"
        }
      ],
      "destination": "/api/share?kind=:kind&value=:value&lang=:lang"
    },
    {
      "source": "/partilha/:kind/:value",
      "destination": "/api/share?kind=:kind&value=:value"
    },
    {
      "source": "/api/auth/:path*",
      "destination": "/api/auth/[...all]"
    }
  ]
}
