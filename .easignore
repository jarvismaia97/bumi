# Prioritised over .gitignore when EAS uploads the project, so it has to repeat it.
# Kept in step with .gitignore by hand: anything added there belongs here too.
# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# Claude Code local settings
.claude/settings.local.json

# local env files
.env
.env.*
!.env.example

# Apple / Google credentials — never commit
AuthKey_*.p8
google-services.json
GoogleService-Info.plist

# typescript
*.tsbuildinfo

example

# local browser-automation debug output
.playwright-cli/
.playwright-mcp/*
!.playwright-mcp/*.js

# generated native folders
/ios
/android
.vercel
content/social/
.env*.local
.planning/
# The one exception, and the reason this file exists: `android.googleServicesFile` points at
# google-services.json, which stays out of git because the repo is public — but the Android
# build cannot register with FCM without it. The `!` has to come last to win.
!google-services.json
