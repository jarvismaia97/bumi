# Server-only. Set this in Vercel/Neon, never with EXPO_PUBLIC_.
DATABASE_URL=
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=https://www.jogarbumi.pt
# Web OAuth client. Used for the browser redirect flow and as the id-token audience.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# iOS OAuth client, from the SAME Google Cloud project as GOOGLE_CLIENT_ID.
# Accepted as an additional id-token audience for native sign-in.
GOOGLE_IOS_CLIENT_ID=
# Generate with: npm run generate-apple-secret -- /path/to/AuthKey_XXXXXXXXXX.p8
# APPLE_CLIENT_SECRET is a signed JWT; Apple caps it at six months, so it must be rotated.
# Generate both with: npm run generate-apple-secret -- /path/to/AuthKey_XXXXXXXXXX.p8 <servicesId>
#
# APPLE_CLIENT_ID is the *Services ID*, not the bundle id. Apple refuses an App ID as the
# client_id of a web OAuth flow, so the bundle id alone can only ever sign a user in on iOS.
# The bundle id still travels, in APPLE_APP_BUNDLE_IDENTIFIER, and better-auth accepts tokens
# for either — which is how one server serves the native sheet and the browser at once.
APPLE_CLIENT_ID=pt.jogarbumi.app.web
APPLE_CLIENT_SECRET=
APPLE_APP_BUNDLE_IDENTIFIER=pt.jogarbumi.app

# Better Auth API origin for Expo native and local web development.
EXPO_PUBLIC_API_BASE_URL=
EXPO_PUBLIC_AUTH_API_URL=https://www.jogarbumi.pt
# Set to true only after the Apple provider variables above are live in Vercel.
# This one gates the *native sheet*, so it belongs to an iOS build and comes from eas.json.
EXPO_PUBLIC_APPLE_SIGN_IN_ENABLED=false
# And this one gates the button everywhere else, where the browser does the work. Separate,
# because the two fail for different reasons: the native sheet needs a device that can present
# it, the web flow needs a Services ID that Apple will accept as a client_id.
EXPO_PUBLIC_APPLE_WEB_SIGN_IN_ENABLED=false
# Native Google sign-in. OAuth client ids are public; these are baked into the build.
# Production/preview/development values live in eas.json.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=

# Error reporting. Both are optional and everything is inert without them, which is the normal
# state in a local checkout — a DSN here would post local crashes into the shared issue list.
# The two are separate projects on purpose: a crash on a phone and a 500 from a handler are
# different faults, and reading them together only works if each says which it is.
#
# The app DSN is public by nature (it ships inside the bundle) and only permits sending events.
EXPO_PUBLIC_SENTRY_DSN=
# Names the release channel in Sentry. Defaults to production when unset.
EXPO_PUBLIC_SENTRY_ENV=
# Server side, for the Vercel functions. Set this in the Vercel project, not here.
SENTRY_DSN=
# Build-time only, for uploading source maps from EAS. Never needed at runtime, and it is a
# write credential — keep it out of this file and set it as a sensitive EAS secret.
# SENTRY_AUTH_TOKEN=
