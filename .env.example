# Server-only. Set this in Vercel/Neon, never with EXPO_PUBLIC_.
DATABASE_URL=
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=https://www.jogarbumi.pt
# Web OAuth client. Used for the browser redirect flow and as the id-token audience.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# iOS OAuth client, from the SAME Google Cloud project as GOOGLE_CLIENT_ID.
# Accepted as an additional id-token audience for native sign-in.
GOOGLE_IOS_CLIENT_ID=
# Generate with: npm run generate-apple-secret -- /path/to/AuthKey_XXXXXXXXXX.p8
# APPLE_CLIENT_SECRET is a signed JWT; Apple caps it at six months, so it must be rotated.
APPLE_CLIENT_ID=pt.jogarbumi.app
APPLE_CLIENT_SECRET=
APPLE_APP_BUNDLE_IDENTIFIER=pt.jogarbumi.app

# Better Auth API origin for Expo native and local web development.
EXPO_PUBLIC_API_BASE_URL=
EXPO_PUBLIC_AUTH_API_URL=https://www.jogarbumi.pt
# Set to true only after the Apple provider variables above are live in Vercel.
EXPO_PUBLIC_APPLE_SIGN_IN_ENABLED=false
# Native Google sign-in. OAuth client ids are public; these are baked into the build.
# Production/preview/development values live in eas.json.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
